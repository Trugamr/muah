# muah — fzf color theme
# Generated from palette/dark.json — do not edit by hand.
#
# Install: point fzf at this file via FZF_DEFAULT_OPTS_FILE
#   export FZF_DEFAULT_OPTS_FILE=~/.config/fzf/muah.opts

--color=fg:#f0f6fc
--color=bg:#0d1117
--color=hl:#9adfb0

--color=fg+:#f0f6fc
--color=bg+:#212830
--color=hl+:#9adfb0

--color=info:#9198a1
--color=prompt:#ef8fb4
--color=pointer:#ef8fb4
--color=marker:#87d29c
--color=spinner:#7eb1f0
--color=header:#b59cea
--color=border:#3d444d
--color=gutter:#0d1117

--color=preview-fg:#f0f6fc
--color=preview-bg:#010409
