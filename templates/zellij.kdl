            emphasis_1 {{cyan}}
            emphasis_2 {{green}}
            emphasis_3 {{pink}}
        }
        exit_code_success {
            base {{green}}
            background {{mantle}}
            emphasis_0 {{bright_purple}}
            emphasis_1 {{cyan}}
            emphasis_2 {{green}}
            emphasis_3 {{pink}}
        }
        exit_code_error {
            base {{red}}
            background {{mantle}}
            emphasis_0 {{bright_purple}}
            emphasis_1 {{cyan}}
            emphasis_2 {{green}}
            emphasis_3 {{pink}}
        }
        multiplayer_user_colors {
            player_1 {{bronze}}
            player_2 {{moss}}
            player_3 {{rose}}
            player_4 {{violet}}
            player_5 {{cobalt}}
            player_6 {{vermillion}}
            player_7 {{overlay1}}
